# FLATUP AI OS - 環境設定ファイル
# このファイルを .env にコピーして、各値を設定してください

# ========================================
# Mac 環境（開発・知識管理）
# ========================================

# Obsidian フォルダパス
OBSIDIAN_PATH=/Users/jin/Documents/Obsidian Vault/FLATUP_BRAIN

# GitHub リポジトリ
GITHUB_REPO=flatup02-source/asukenn
GITHUB_TOKEN=your_github_token_here
GITHUB_BRANCH=main

# ========================================
# VPS 環境（本番環境）
# ========================================

# VPS ホスト情報
VPS_HOST=your.vps.hostname
VPS_USER=root
VPS_PORT=22
VPS_SSH_KEY=/path/to/ssh/key

# ========================================
# Dify（AI アプリ構築・LINE BOT）
# ========================================

# Dify API キー
DIFY_API_KEY=your_dify_api_key_here
DIFY_BASE_URL=http://localhost:8001/api

# Dify 本番環境（VPS側）
DIFY_PROD_API_KEY=your_prod_dify_api_key_here
DIFY_PROD_BASE_URL=https://your.vps.hostname:8001/api

# ========================================
# Qdrant（ベクトル DB）
# ========================================

# Qdrant ホスト
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant_api_key_here

# 本番環境
QDRANT_PROD_HOST=your.vps.hostname
QDRANT_PROD_PORT=6333
QDRANT_PROD_API_KEY=your_prod_qdrant_api_key_here

# ========================================
# Ollama（ローカル LLM）
# ========================================

# Ollama ホスト（ローカル開発用）
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral

# 本番環境
OLLAMA_PROD_HOST=http://your.vps.hostname:11434
OLLAMA_PROD_MODEL=mistral

# ========================================
# n8n（自動化・ワークフロー）
# ========================================

# n8n ホスト
N8N_HOST=localhost
N8N_PORT=5678
N8N_API_KEY=your_n8n_api_key_here

# 本番環境
N8N_PROD_HOST=your.vps.hostname
N8N_PROD_PORT=5678
N8N_PROD_API_KEY=your_prod_n8n_api_key_here

# ========================================
# LINE BOT
# ========================================

# LINE チャネルID・シークレット
LINE_CHANNEL_ID=your_line_channel_id_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_ACCESS_TOKEN=your_line_access_token_here

# ========================================
# SNS 連携
# ========================================

# Twitter API
TWITTER_API_KEY=your_twitter_api_key_here
TWITTER_API_SECRET=your_twitter_api_secret_here
TWITTER_ACCESS_TOKEN=your_twitter_access_token_here
TWITTER_ACCESS_TOKEN_SECRET=your_twitter_access_token_secret_here

# Instagram
INSTAGRAM_ACCESS_TOKEN=your_instagram_access_token_here

# ========================================
# ジム情報
# ========================================

# 基本情報
GYM_NAME=FLATUP GYM
GYM_LOCATION=Your Location
GYM_PHONE=090-XXXX-XXXX
GYM_EMAIL=info@flatup-gym.com

# 体験料金
TRIAL_PRICE=500

# ========================================
# AI 性格設定
# ========================================

# AIKAの性格（SOUL.md から読み込まれる）
AI_PERSONALITY=AIKA
AI_TONE=cool_and_friendly

# ========================================
# ログ設定
# ========================================

LOG_LEVEL=info
LOG_FILE=/var/log/flatup-ai/app.log

# ========================================
# その他
# ========================================

# 開発モード
DEBUG=false
ENVIRONMENT=development
